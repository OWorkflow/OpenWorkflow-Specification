# OpenWorkflow Specification .gitignore

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editor/IDE Files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath
*.sublime-project
*.sublime-workspace

# Documentation Build Artifacts
_build/
.doctrees/
docs/_build/
site/
.mkdocs/

# Python (if used for tooling/validation)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/

# Node.js (if used for tooling/validation)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.npm
.eslintcache

# Logs
*.log
logs/
*.log.*

# Temporary Files
*.tmp
*.temp
tmp/
temp/
.cache/

# Secrets and Credentials (IMPORTANT)
.env
.env.local
.env.*.local
*.key
*.pem
secrets.yaml
credentials.json
config.local.yaml

# Test Artifacts
test-results/
coverage/
*.coverage
.nyc_output/

# Generated Files
*.generated.*
schema.json
openapi.json

# Backup Files
*.bak
*.backup
*.old

# Archive Files
*.zip
*.tar.gz
*.rar

# Local Development
.local/
scratch/
notes.txt
TODO.local.md
CHANGELOG.md

# CI/CD (keep GitHub Actions, but ignore local CI artifacts)
.gitlab-ci-local/
.circleci/local/

# Don't ignore these important files
!.gitkeep
!.github/
